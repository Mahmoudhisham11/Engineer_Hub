# EngineerHub Environment Configuration Example
APP_NAME=EngineerHub
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration (SQLite)
# Local file: sqlite:///./data/engineerhub.db
# Network UNC share example: sqlite://///DME-SERVER/DME-SHARE/EngineerHub/engineerhub.db
DATABASE_URL=sqlite:///./data/engineerhub.db

# JWT & Security
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=engineerhub-super-secret-jwt-token-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Business Rules
MAX_DAILY_WORK_HOURS=24.0
NON_WORKING_DAYS=4,5

# CORS - Comma-separated allowed origins (e.g., http://localhost:3000,app://-)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,app://-,file://

# Initial Admin Seeding (Used by CLI seed tool)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@dme.internal
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
