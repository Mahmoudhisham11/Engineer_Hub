{
  "name": "engineerhub-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); } catch (e) {}\"",
    "electron": "electron .",
    "desktop": "concurrently -k \"next dev -p 3000\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:prod": "concurrently -k \"next start -p 3000\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "lint": "next lint"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "wait-on": "^8.0.2"
  }
}
